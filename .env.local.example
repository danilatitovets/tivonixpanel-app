# Copy to .env.local — never commit real secrets

NEXT_PUBLIC_DEMO_MODE=false
# Demo UI seed (local only). Requires NODE_ENV!=production AND ALLOW_DEMO_MODE=true
# ALLOW_DEMO_MODE=false

# Public site URL (Render production) — used for Auth email redirects
# APP_URL=https://tivonixpanel-web.onrender.com
# NEXT_PUBLIC_APP_URL=https://tivonixpanel-web.onrender.com

# --- Frontend service (tivonixpanel-web) ---
# Proxy /api/* to backend (same-origin for browser cookies)
# INTERNAL_API_URL=https://tivonixpanel-backend.onrender.com
# APP_SERVICE=frontend

# --- Backend API service (tivonixpanel-api) ---
# APP_SERVICE=api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SECRET_KEY=your-service-role-key-server-only

# Optional: PostgreSQL direct URL for scripts/apply-migrations-pg.cjs only
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_SUPPORT_TELEGRAM=https://t.me/your_support

# Optional: notify admins about new partner applications (server-only)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# --- Audit isolation users (scripts/create-audit-users.cjs) ---
# AUDIT_ADMIN_EMAIL=
# AUDIT_ADMIN_PASSWORD=
# AUDIT_PARTNER_A_EMAIL=
# AUDIT_PARTNER_A_PASSWORD=
# AUDIT_PARTNER_B_EMAIL=
# AUDIT_PARTNER_B_PASSWORD=
